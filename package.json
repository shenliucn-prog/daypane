{
  "name": "daypane",
  "version": "0.3.3",
  "description": "DayPane: repurpose a jailbroken Amazon Kindle as an e-ink dashboard with KOReader. Weather, world clocks, market data and daily information, rendered locally or with GitHub Actions.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "pretest": "node scripts/build-fixtures.mjs",
    "test": "node --test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "better-sqlite3": "^12.0.0"
  },
  "devDependencies": {
    "eslint": "^9.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "keywords": [
    "kindle",
    "kindle-dashboard",
    "eink",
    "e-ink",
    "koreader",
    "koreader-plugin",
    "dashboard",
    "repurpose"
  ]
}
